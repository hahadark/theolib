    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": ["resources/free/*"]
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/hahadark/theolib/releases/latest/download/latest.json"],
