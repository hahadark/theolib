{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "신학 서재",
  "version": "0.5.6",
  "identifier": "kr.theolib.app",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "신학 서재", "width": 1320, "height": 840, "minWidth": 900, "minHeight": 600 }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://github.com https://objects.githubusercontent.com https://release-assets.githubusercontent.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
